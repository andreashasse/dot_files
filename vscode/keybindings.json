// VS Code key bindings. Linked from
// ~/Library/Application Support/Code/User/keybindings.json.
[
  // M-? peeks at references inline, like M-? in Emacs. emacs-mcx opens the
  // references side panel instead, so turn that binding off.
  // On a Swedish keyboard ? is Shift and the key right of 0, which VS Code
  // calls [Minus] by its US position. cmd+shift+/ covers a US keyboard.
  {
    "key": "cmd+shift+[Minus]",
    "command": "editor.action.referenceSearch.trigger",
    "when": "editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
  },
  {
    "key": "cmd+shift+/",
    "command": "editor.action.referenceSearch.trigger",
    "when": "editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
  },
  {
    "key": "cmd+shift+/",
    "command": "-references-view.findReferences",
    "when": "editorHasReferenceProvider && config.emacs-mcx.useMetaPrefixMacCmd"
  },
  // M-t and M-g i list the symbols in the file, like consult-imenu in
  // Emacs. The code follows the selection. M-t replaces emacs-mcx's
  // transpose-words.
  {
    "key": "cmd+t",
    "command": "workbench.action.gotoSymbol",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+g i",
    "command": "workbench.action.gotoSymbol",
    "when": "!terminalFocus"
  },
  // M-o grows the selection one syntax level, M-O shrinks it, like expreg
  // in Emacs. They replace Open File (Cmd-O) and the default symbol list
  // key (Cmd-Shift-O), which is on M-t instead.
  // The levels come from the tree-sitter parse tree (Code Blocks). M-O
  // steps back to the previous selection, like expreg. Code Blocks' own
  // shrink jumps to the first child node instead.
  // Languages Code Blocks ignores (codeBlocks.ignoredLanguageIds in
  // settings.json) keep VS Code's smart select. These come later, so they
  // win.
  {
    "key": "cmd+o",
    "command": "codeBlocks.selectParent",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+shift+o",
    "command": "cursorUndo",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+o",
    "command": "editor.action.smartSelect.expand",
    "when": "editorTextFocus && editorLangId =~ /^(phoenix-heex|plaintext|Log|ignore)$/"
  },
  {
    "key": "cmd+shift+o",
    "command": "editor.action.smartSelect.shrink",
    "when": "editorTextFocus && editorLangId =~ /^(phoenix-heex|plaintext|Log|ignore)$/"
  },
  // C-c C-c comments on the PR line at point, like pr-review in Emacs.
  // In the comment box, C-c C-c submits it (Cmd-Enter also works).
  {
    "key": "ctrl+c ctrl+c",
    "command": "workbench.action.addComment",
    "when": "editorTextFocus && activeCursorHasCommentingRange && !commentEditorFocused"
  },
  {
    "key": "ctrl+c ctrl+c",
    "command": "editor.action.submitComment",
    "when": "commentEditorFocused"
  }
]
